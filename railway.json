{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "keycloak",
      "source": {
        "type": "dockerfile",
        "dockerfilePath": "Dockerfile"
      },
      "settings": {
        "lifecycle": "STARTUP",
        "restartPolicyType": "ALWAYS",
        "startCommand": "/opt/keycloak/bin/kc.sh start",
        "healthcheckPath": "/health/ready"
      },
      "deploy": {
        "startDelay": 120,
        "healthCheckPath": "/health/ready",
        "restartPolicyType": "ALWAYS",
        "healthCheckTimeout": 180
      }
    }
  ]
}
