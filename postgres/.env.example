# ============================================================
# Sibling PostgreSQL service for Keycloak
# ============================================================
# These values are set via the template deploy form on the
# postgres service tile, NOT via shell env. They must match
# the corresponding values on the Keycloak service tile.

# Superuser name. Must equal KC_DB_USERNAME on Keycloak.
POSTGRES_USER=keycloak

# Superuser password. Must equal KC_DB_PASSWORD on Keycloak.
# Cross-service ${{...}} macros resolve empty in marketplace
# deploys, so the password is hardcoded in both forms. Change
# both at once if rotating.
POSTGRES_PASSWORD=keycloak_pw_2026

# Default database. Keycloak creates its schema on first run.
POSTGRES_DB=keycloak

# Data directory. MUST match the volume mount path configured
# in the postgres service settings (Volume widget) — mount the
# volume at the PARENT path /var/lib/postgresql so the ext4
# `lost+found/` directory lives outside PGDATA. initdb then sees
# an empty data dir and proceeds. See ./Dockerfile for details.
PGDATA=/var/lib/postgresql/data
