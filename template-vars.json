{
  "DB_TYPE": {
    "defaultValue": "postgres",
    "description": "Database engine: postgres for production, sqlite for local dev",
    "isOptional": true
  },
  "PG_HOSTNAME": {
    "defaultValue": "localhost",
    "description": "Hostname for PG_HOSTNAME",
    "isOptional": true
  },
  "PG_PORT": {
    "defaultValue": "5432",
    "description": "Port number for PG_PORT",
    "isOptional": true
  },
  "PG_DATABASE": {
    "defaultValue": "railway",
    "description": "Pg Database",
    "isOptional": true
  },
  "PG_USERNAME": {
    "defaultValue": "railway",
    "description": "Pg Username",
    "isOptional": true
  },
  "PG_PASSWORD": {
    "defaultValue": "${{secret(32)}}",
    "description": "Password credential for PG_PASSWORD",
    "isOptional": false
  },
  "KEYCLOAK_ADMIN_USERNAME": {
    "defaultValue": "admin",
    "description": "Keycloak Admin Username",
    "isOptional": true
  },
  "KEYCLOAK_ADMIN_PASSWORD": {
    "defaultValue": "${{secret(32)}}",
    "description": "Password credential for KEYCLOAK_ADMIN_PASSWORD",
    "isOptional": false
  },
  "KC_PROXY": {
    "defaultValue": "edge",
    "description": "Kc Proxy",
    "isOptional": true
  },
  "KC_HTTP_ENABLED": {
    "defaultValue": "false",
    "description": "Kc Http Enabled",
    "isOptional": true
  },
  "KEYCLOAK_HOSTNAME": {
    "defaultValue": "localhost",
    "description": "Hostname for KEYCLOAK_HOSTNAME",
    "isOptional": true
  },
  "PORT": {
    "defaultValue": "8080",
    "description": "Port the service listens on inside the container",
    "isOptional": true
  }
}
