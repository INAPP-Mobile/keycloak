{
  "DB_TYPE": {
    "defaultValue": "postgres",
    "description": "Database engine: postgres for production, sqlite for local dev",
    "isOptional": true
  },
  "PG_HOSTNAME": {
    "defaultValue": "localhost",
    "description": "PostgreSQL server hostname (required when KC_DB=prod-pg)",
    "isOptional": true
  },
  "PG_PORT": {
    "defaultValue": "5432",
    "description": "PostgreSQL port. Default: 5432",
    "isOptional": true
  },
  "PG_DATABASE": {
    "defaultValue": "railway",
    "description": "PostgreSQL database name (required when KC_DB=prod-pg)",
    "isOptional": true
  },
  "PG_USERNAME": {
    "defaultValue": "railway",
    "description": "PostgreSQL username (required when KC_DB=prod-pg)",
    "isOptional": true
  },
  "PG_PASSWORD": {
    "defaultValue": "${{secret(32)}}",
    "description": "PostgreSQL server password (required when KC_DB=prod-pg)",
    "isOptional": false
  },
  "KEYCLOAK_ADMIN_USERNAME": {
    "defaultValue": "admin",
    "description": "Admin username for Keycloak login. Default: admin",
    "isOptional": true
  },
  "KEYCLOAK_ADMIN_PASSWORD": {
    "defaultValue": "${{secret(32)}}",
    "description": "Admin user password for Keycloak login. Default: keycloak123",
    "isOptional": false
  },
  "KC_PROXY": {
    "defaultValue": "edge",
    "description": "Proxy mode. Valid: edge, passthrough (edge for Railway)",
    "isOptional": true
  },
  "KC_HTTP_ENABLED": {
    "defaultValue": "false",
    "description": "Enable HTTP server (true/false). Default: true",
    "isOptional": true
  },
  "KEYCLOAK_HOSTNAME": {
    "defaultValue": "localhost",
    "description": "Keycloak host (used in realm/URLs). Required if using custom domain",
    "isOptional": true
  },
  "PORT": {
    "defaultValue": "8080",
    "description": "Port the service listens on inside the container",
    "isOptional": true
  }
}
