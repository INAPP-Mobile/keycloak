# ============================================================
# Keycloak 26.x Environment Variables
# ============================================================
# These are set via the template deploy form on the Keycloak
# service tile. Defaults shown below match the template form.
# The Keycloak service connects to the sibling postgres service
# in the same project — no external DB setup required.

# Public URL Keycloak generates links with. The deploy form
# defaults to https://${{RAILWAY_PUBLIC_DOMAIN}} (Railway
# terminates TLS). Update to a custom domain if you add one.
KC_HOSTNAME=https://keycloak-production-xxxx.up.railway.app

# Initial admin username (Keycloak 26.x bootstrap).
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# Initial admin password (Keycloak 26.x bootstrap). Auto-
# generated as ${{secret(32)}} in the template form. After the
# admin user is created on first deploy, changing this has no
# effect — rotate via the Admin UI instead.
KC_BOOTSTRAP_ADMIN_PASSWORD=

# ----- PostgreSQL connection (sibling postgres service) -----

# JDBC URL. Points at the sibling postgres service on the
# Railway private network. Username and password are read
# from KC_DB_USERNAME and KC_DB_PASSWORD env vars (do NOT
# embed them in the URL).
KC_DB_URL=jdbc:postgresql://postgres.railway.internal:5432/keycloak

# PostgreSQL username. Must equal POSTGRES_USER on the
# postgres tile (default: keycloak).
KC_DB_USERNAME=keycloak

# PostgreSQL password. Must equal POSTGRES_PASSWORD on the
# postgres tile (default: keycloak_pw_2026). Cross-service
# ${{...}} macros resolve empty in marketplace deploys, so
# the same literal is set on both tiles. Change both at once.
KC_DB_PASSWORD=keycloak_pw_2026

# ----- Proxy / HTTP / Logging -----

# Proxy mode. 'edge' = Railway terminates TLS, Keycloak serves
# HTTP. 'passthrough' = external proxy handles both TLS and
# forwarding. 'reencrypt' = external proxy terminates TLS, then
# re-encrypts to Keycloak.
KC_PROXY=edge

# Plain HTTP listener. Required when KC_PROXY=edge so Keycloak
# can serve HTTP and rely on Railway for TLS termination.
KC_HTTP_ENABLED=true

# Proxy headers handling (Keycloak 26.x: KC_PROXY_HEADERS).
# Set to xforwarded when behind a reverse proxy like Railway so Keycloak
# honors X-Forwarded-* headers (host, proto, port).
KC_PROXY_HEADERS=xforwarded

# Log verbosity. info | debug | trace | warn | error | fatal.
KC_LOG_LEVEL=info
