# ============================================================
# Keycloak Template Variables — copy to .env.production or set directly on Railway
# See README.md for deployment instructions
# ============================================================

# ── Database ──────────────────────────────────────────────────────
DB_TYPE=postgres          # postgres | sqlite (use postgres for production)

# PostgreSQL connection (when DB_TYPE=postgres)
PG_HOSTNAME=  
PG_PORT=5432
PG_DATABASE=keycloak
PG_USERNAME=keycloak
PG_PASSWORD=

# ── Keycloak ─────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=changeme123456789

# HTTP vs HTTPS mode
KC_PROXY=edge             # edge = terminate TLS externally; pass-through when behind proxy
KC_HTTP_ENABLED=false     # set true for development, false for production with reverse proxy

# Keycloak hostname (used for URL generation)
KEYCLOAK_HOSTNAME=localhost  # MUST be set to the deployed URL before first login
