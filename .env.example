# =============================================================================
# Keycloak 26.x – Railway deployment environment variables
# See README.md for setup guide
# =============================================================================

# ── Hostname & protocol ──────────────────────────────────────────────────────
KC_HTTP_ENABLED=true                          # Set true for HTTP (Railway handles TLS)
KEYCLOAK_HOSTNAME=                              # Public hostname (get from Railway dashboard)
KEYCLOAK_ADMIN_PASSWORD=changeme123456          # Admin password (>= 12 characters required)
