# ============================================================
# Keycloak Environment Variables
# ============================================================
# Database — Keycloak uses PostgreSQL for production.
# Set DB_TYPE to 'sqlite' for local development only. For Railway
# deployments, PostgreSQL via the companion DB is strongly recommended.
DB_TYPE=postgres

# PostgreSQL connection settings (when DB_TYPE=postgres)
PG_HOSTNAME=localhost
PG_PORT=5432
PG_DATABASE=keycloak
PG_USERNAME=keycloak
PG_PASSWORD=

# Admin — Initial admin credentials for the Keycloak master realm.
# These are used only on first-ever startup. After the admin user
# is created, changing these has no effect — use the Admin UI instead.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Proxy — Keycloak needs to know if it's behind a reverse proxy.
#   edge        = Railway terminates TLS, Keycloak serves HTTP (default)
#   passthrough = external proxy handles both TLS and forwarding
#   reencrypt   = external proxy terminates TLS, re-encrypts to Keycloak
KC_PROXY=edge

# HTTP listener — Set to 'true' only if you need Keycloak to serve
# plain HTTP internally (e.g., behind a Railway proxy that handles TLS).
# For most Railway deployments, 'false' (HTTPS-only) is correct.
KC_HTTP_ENABLED=false

# Hostname — The public URL users will access Keycloak at.
# This MUST match your Railway-generated domain or custom domain.
# Example: https://keycloak-production-xxxx.up.railway.app
KEYCLOAK_HOSTNAME=localhost

# Port — The port Keycloak binds to inside the container.
# Railway automatically injects PORT, so you usually don't need to
# change this unless your deployment requires a specific port.
PORT=8080
